---
import contributions from '../data/github-contributions.json';

const levelClasses = {
  0: 'bg-border/60',
  1: 'bg-emerald-300 dark:bg-emerald-900',
  2: 'bg-emerald-400 dark:bg-emerald-700',
  3: 'bg-emerald-600 dark:bg-emerald-500',
  4: 'bg-emerald-800 dark:bg-emerald-300',
} as const;

const formatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
  year: 'numeric',
});
const monthFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  timeZone: 'UTC',
});
const parseDate = (date: string) => {
  const [year, month, day] = date.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day));
};

const formatContributions = (count: number) =>
  `${count} contribution${count === 1 ? '' : 's'}`;

const days = contributions.weeks.flat();
const monthLabels = contributions.weeks.reduce<
  Array<{ name: string; column: number }>
>((labels, week, index) => {
  const firstDay = week[0];
  if (!firstDay) return labels;

  const firstDate = parseDate(firstDay.date);
  const firstMonthDays = week.filter(
    (day) => parseDate(day.date).getUTCMonth() === firstDate.getUTCMonth(),
  );
  if (index === 0 && firstMonthDays.length < 4) return labels;

  const name = monthFormatter.format(firstDate);
  if (labels.at(-1)?.name !== name) labels.push({ name, column: index + 1 });
  return labels;
}, []);
---

<figure
  class='col-span-full min-w-0 pt-6'
  aria-label={`${contributions.total} GitHub contributions in the last year`}
>
  <div
    class='min-w-0 touch-pan-x [scrollbar-width:none] overflow-x-auto overscroll-x-contain [-ms-overflow-style:none] [-webkit-overflow-scrolling:touch] [&::-webkit-scrollbar]:hidden'
    data-contribution-scroll
    tabindex='0'
    role='region'
    aria-label='Scrollable contribution graph'
  >
    <div class='w-max'>
      <div
        class='text-muted mb-1 grid grid-cols-[repeat(53,0.625rem)] gap-1 px-px font-mono text-[0.625rem] leading-none'
        aria-hidden='true'
      >
        {
          monthLabels.map((month) => (
            <span
              class='whitespace-nowrap'
              style={`grid-column: ${month.column}`}
            >
              {month.name}
            </span>
          ))
        }
      </div>

      <div
        class='grid grid-flow-col grid-cols-[repeat(53,0.625rem)] grid-rows-7 gap-1'
        data-contribution-graph
        role='group'
        aria-label='Daily contribution activity'
      >
        {
          days.map((day) => {
            const label = `${formatContributions(day.count)} on ${formatter.format(parseDate(day.date))}`;
            return (
              <span
                class:list={[
                  levelClasses[day.level],
                  'size-2.5 rounded-[2px] select-none',
                ]}
                data-tooltip={label}
                role='img'
                aria-label={label}
              />
            );
          })
        }
      </div>
    </div>
  </div>

  <figcaption
    class='mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-3'
  >
    <p class='text-primary m-0 text-base'>
      <span class='font-semibold tabular-nums'>{contributions.total}</span>{' '}
      contributions in the last year
    </p>
    <a
      href={`https://github.com/${contributions.username}`}
      target='_blank'
      rel='noopener noreferrer'
      class='link-underline text-secondary hover:text-primary text-sm'
    >
      view profile
    </a>
    <div
      class='text-muted flex items-center gap-2 font-mono text-[0.625rem]'
      aria-label='Contribution intensity legend'
    >
      <span>less</span>
      <div class='flex gap-1' aria-hidden='true'>
        {
          [0, 1, 2, 3, 4].map((level) => (
            <span
              class:list={[
                levelClasses[level as keyof typeof levelClasses],
                'size-2.5 rounded-[2px]',
              ]}
            />
          ))
        }
      </div>
      <span>more</span>
    </div>
  </figcaption>
</figure>
