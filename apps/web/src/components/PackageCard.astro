---
import { Icon } from 'astro-icon/components';
import type { Package } from '../data/packages';

interface Props extends Package {}

const {
  title,
  icon,
  name,
  scope,
  description,
  version,
  npm,
  github,
  website,
  installCommand,
} = Astro.props;

const fullName = scope ? `@${scope}/${name}` : name;
const cmd = installCommand ?? `npm install ${fullName}`;
---

<article
  class='flex w-full flex-col gap-1.5 py-5 transition-opacity duration-[var(--duration-fast)] ease-[var(--ease-in-out)]'
>
  <div class='flex items-baseline justify-between gap-4'>
    <h3 class='text-primary text-base font-normal'>
      {icon && <Icon name={icon} class='mr-1.5 inline-block size-4 align-[-0.125em]' />}
      {title ?? fullName}
      <span class='text-muted ml-1.5 font-mono text-xs'>v{version}</span>
    </h3>
    <div class='flex shrink-0 gap-2'>
      <a
        href={npm}
        target='_blank'
        rel='noopener noreferrer'
        class='text-muted hover:text-primary transition-colors duration-[var(--duration-fast)]'
      >
        <Icon name='npm' class='size-4' />
        <span class='sr-only'>npm package</span>
      </a>
      {
        github && (
          <a
            href={github}
            target='_blank'
            rel='noopener noreferrer'
            class='text-muted hover:text-primary transition-colors duration-[var(--duration-fast)]'
          >
            <Icon name='github-logo' class='size-4' />
            <span class='sr-only'>GitHub repository</span>
          </a>
        )
      }
      {
        website && (
          <a
            href={website}
            target='_blank'
            rel='noopener noreferrer'
            class='text-muted hover:text-primary group/link transition-colors duration-[var(--duration-fast)]'
          >
            <Icon
              name='arrow-top-right'
              class='size-4 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5'
            />
            <span class='sr-only'>View website</span>
          </a>
        )
      }
    </div>
  </div>

  <p class='text-muted text-sm'>{description}</p>

  <div
    class='text-muted flex items-center gap-2 pt-1 font-mono text-xs'
  >
    <code class='text-secondary min-w-0 truncate'>$ {cmd}</code>
    <button
      type='button'
      class='text-muted hover:text-primary shrink-0 transition-colors duration-[var(--duration-fast)]'
      data-copy-command={cmd}
      aria-label={`Copy ${cmd}`}
    >
      <Icon name='copy' class='size-3.5' data-copy-icon />
      <Icon name='check' class='hidden size-3.5' data-copied-icon />
    </button>
  </div>
</article>

<script>
  // delegated so copy buttons keep working after view-transition DOM swaps
  const copyTimers = new WeakMap<HTMLButtonElement, number>();
  const copySequences = new WeakMap<HTMLButtonElement, number>();

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-copy-command]',
    );
    if (!button) return;

    const command = button.dataset.copyCommand;
    if (!command) return;

    const sequence = (copySequences.get(button) ?? 0) + 1;
    copySequences.set(button, sequence);
    await navigator.clipboard.writeText(command);
    if (copySequences.get(button) !== sequence) return;

    const existingTimer = copyTimers.get(button);
    if (existingTimer) window.clearTimeout(existingTimer);
    button.querySelector('[data-copy-icon]')?.classList.add('hidden');
    button.querySelector('[data-copied-icon]')?.classList.remove('hidden');
    button.setAttribute('aria-label', 'Command copied');
    copyTimers.set(
      button,
      window.setTimeout(() => {
        if (copySequences.get(button) !== sequence) return;
        button
          .querySelector('[data-copy-icon]')
          ?.classList.remove('hidden');
        button.querySelector('[data-copied-icon]')?.classList.add('hidden');
        button.setAttribute('aria-label', `Copy ${command}`);
        copyTimers.delete(button);
      }, 1500),
    );
  });
</script>
