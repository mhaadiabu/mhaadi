---
import { Icon } from 'astro-icon/components';
import type { Package } from '../data/packages';

interface Props extends Package {}

const {
  name,
  scope,
  description,
  version,
  npm,
  github,
  website,
  installCommand,
} = Astro.props;

const fullName = scope ? `@${scope}/${name}` : name;
const cmd = installCommand ?? `npm install ${fullName}`;
---

<article
  class="bg-bg-secondary flex w-full flex-col gap-3 rounded-lg p-4 shadow-card"
>
  <div
    class="bg-bg-secondary border-border flex items-center gap-2 rounded-md border px-3 py-2 font-mono text-xs"
  >
    <span class="text-secondary/50 select-none">$</span>
    <code class="text-primary bg-transparent!">{cmd}</code>
  </div>

  <div class="flex flex-col gap-2">
    <div class="flex items-center justify-between">
      <h3 class="text-primary text-sm font-normal">{fullName}</h3>
      <span
        class="text-muted border-border bg-bg-secondary/50 rounded-md border px-1.5 py-0.5 font-mono text-xs"
      >
        v{version}
      </span>
    </div>

    <p class="text-muted text-xs">{description}</p>

    <div class="flex items-center justify-between pt-1">
      <div class="flex gap-2">
        <a
          href={npm}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-primary transition-colors duration-[var(--duration-fast)]"
        >
          <Icon name="npm" class="size-4" />
          <span class="sr-only">npm package</span>
        </a>
        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-primary transition-colors duration-[var(--duration-fast)]"
            >
              <Icon name="github-logo" class="size-4" />
              <span class="sr-only">GitHub repository</span>
            </a>
          )
        }
      </div>
      {
        website && (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary group/link transition-colors duration-[var(--duration-fast)]"
          >
            <Icon
              name="arrow-top-right"
              class="size-4 transition-transform duration-[var(--duration-fast)] ease-[var(--ease-smooth-out)] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
            />
            <span class="sr-only">View website</span>
          </a>
        )
      }
    </div>
  </div>
</article>
