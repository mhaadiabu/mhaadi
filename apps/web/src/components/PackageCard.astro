---
import { Icon } from 'astro-icon/components';
import type { Package } from '../data/packages';

interface Props extends Package {}

const { name, scope, description, version, npm, github, installCommand } =
  Astro.props;

const fullName = scope ? `@${scope}/${name}` : name;
const cmd = installCommand ?? `npm install ${fullName}`;
---

<article class="group border-border bg-bg-secondary/50 flex w-full flex-col gap-3 border p-4 transition-all duration-300 hover:border-secondary hover:bg-bg-secondary">
  <div class="bg-bg-secondary border-border flex items-center gap-2 border px-3 py-2 font-mono text-xs">
    <span class="text-secondary/50 select-none">$</span>
    <code class="text-primary">{cmd}</code>
  </div>

  <div class="flex flex-col gap-2">
    <div class="flex items-center justify-between">
      <h3 class="text-primary text-base font-medium">{fullName}</h3>
      <span class="text-muted border-border bg-bg-secondary/50 border px-1.5 py-0.5 font-mono text-xs">
        v{version}
      </span>
    </div>

    <p class="text-muted text-sm">{description}</p>

    <div class="flex gap-2 pt-1">
      <a
        href={npm}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-primary transition-colors duration-200"
      >
        <Icon name="npm" class="size-4" />
      </a>
      {github && (
        <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-primary transition-colors duration-200"
        >
          <Icon name="github-logo" class="size-4" />
        </a>
      )}
    </div>
  </div>
</article>
