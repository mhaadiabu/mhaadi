---
import { Icon } from 'astro-icon/components';
import type { Package } from '../data/packages';

interface Props extends Package {}

const {
  name,
  scope,
  description,
  version,
  npm,
  github,
  website,
  installCommand,
} = Astro.props;

const fullName = scope ? `@${scope}/${name}` : name;
const cmd = installCommand ?? `npm install ${fullName}`;
---

<article
  class="surface-card group flex w-full flex-col gap-3 p-4 hover:-translate-y-0.5"
>
  <div
    class="bg-bg-secondary border-border flex items-center gap-2 border px-3 py-2 font-mono text-xs"
  >
    <span class="text-secondary/50 select-none">$</span>
    <code class="text-primary">{cmd}</code>
  </div>

  <div class="flex flex-col gap-2">
    <div class="flex items-center justify-between">
      <h3 class="text-primary text-sm font-normal">{fullName}</h3>
      <span
        class="text-muted border-border bg-bg-secondary/50 border px-1.5 py-0.5 font-mono text-xs"
      >
        v{version}
      </span>
    </div>

    <p class="text-muted text-xs">{description}</p>

    <div class="flex items-center justify-between pt-1">
      <div class="flex gap-2">
        <a
          href={npm}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link"
        >
          <Icon name="npm" class="size-4" />
          <span class="sr-only">npm package</span>
        </a>
        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-link"
            >
              <Icon name="github-logo" class="size-4" />
              <span class="sr-only">GitHub repository</span>
            </a>
          )
        }
      </div>
      {
        website && (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link group/link"
          >
            <Icon
              name="arrow-top-right"
              class="size-4 transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
            />
            <span class="sr-only">View website</span>
          </a>
        )
      }
    </div>
  </div>
</article>
