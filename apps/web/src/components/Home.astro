---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import face from '../assets/face.png';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import { featuredProjects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';

type PortfolioItem = Project | Package;

const projectsSection: PortfolioItem[] = [...featuredProjects, ...packages];
const firstProjectIndex = projectsSection.findIndex(
  (item) => item.type === 'project',
);

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout>
  {
    // hashed /_astro URLs only exist in a production build
    import.meta.env.PROD && (
      <link
        slot='head'
        rel='preload'
        as='image'
        href='/_astro/task-thing.CZ4I6cSL_16B98y.webp'
        imagesrcset='/_astro/task-thing.CZ4I6cSL_Z2WIbL.webp 320w, /_astro/task-thing.CZ4I6cSL_16B98y.webp 640w'
        imagesizes='(min-width: 48rem) 640px, 100vw'
        fetchpriority='high'
      />
    )
  }

  {
    (
      <header class='flex flex-wrap items-center justify-between gap-4 px-4 pt-16 pb-12 sm:px-6'>
        <div class='flex flex-col gap-1.5'>
          <h1 class='text-primary text-4xl font-semibold tracking-tight sm:text-5xl'>
            haadi
          </h1>
          <p class='text-secondary font-mono text-base'>frontend engineer</p>
        </div>
        <Image
          src={face}
          alt='haadi'
          width={160}
          height={160}
          class='size-32 rounded-full border-2 border-[#0a0a0a] bg-white object-cover sm:size-40'
          loading='eager'
        />
      </header>
    )
  }

  <section class='flex flex-col'>
    <div class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'>
      <h2 class='m-0 flex items-baseline gap-3 text-lg font-normal'>
        <span class='text-muted font-mono text-sm tracking-wide'>01</span>
        <span class='text-primary'>what i like to do</span>
      </h2>
    </div>
    <div class='mx-4 pb-12 sm:mx-6'>
      <WhatIDo />
    </div>
  </section>

  <section class='flex w-full flex-col'>
    <div class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'>
      <h2 class='m-0 flex items-baseline gap-3 text-lg font-normal'>
        <span class='text-muted font-mono text-sm tracking-wide'>02</span>
        <span class='text-primary'>my works</span>
      </h2>
    </div>
    <div class='flex w-full flex-col pb-12'>
      <div
        class='dim-list mt-6 flex w-full flex-col [&>*]:relative [&>article]:px-4 sm:[&>article]:px-6'
      >
        {
          projectsSection.map((item, index) =>
            item.type === 'project' ? (
              <ProjectCard {...item} priority={index === firstProjectIndex} />
            ) : (
              <PackageCard {...item} />
            ),
          )
        }
      </div>
      <p class='mx-4 pt-4 sm:mx-6'>
        interested in other things i&apos;ve worked on? {' '}
        <a
          href='/projects'
          data-astro-prefetch
          class='link-underline group text-secondary hover:text-primary inline-flex items-center gap-1'
        >
          check them out <Icon
            name='arrow-right'
            class='size-3.5 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
          />
        </a>
      </p>
    </div>
  </section>

  <section class='flex flex-col'>
    <div class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'>
      <h2 class='m-0 flex items-baseline gap-3 text-lg font-normal'>
        <span class='text-muted font-mono text-sm tracking-wide'>03</span>
        <span class='text-primary'>recent writes</span>
      </h2>
    </div>
    <div class='flex flex-col pb-12'>
      <div
        class='home-blog-list blog-list relative flex flex-col [&>*]:relative'
      >
        {
          blogPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              data-astro-prefetch
              class='flex w-full flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 sm:px-6'
            >
              <div class='flex flex-col gap-0.5'>
                <span class='text-primary text-lg font-normal'>
                  {post.data.title}
                </span>
                <span class='text-muted line-clamp-3 text-base'>
                  {post.data.description}
                </span>
              </div>
              <time
                datetime={post.data.date.toISOString()}
                class='text-muted pt-1.5 font-mono text-sm whitespace-nowrap tabular-nums sm:pt-0'
              >
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        }
      </div>
      <a
        href='/blog'
        data-astro-prefetch
        class='link-underline text-muted hover:text-primary group mx-4 mt-3 inline-flex w-fit items-center gap-1.5 text-sm sm:mx-6'
      >
        view all posts
        <Icon
          name='arrow-right'
          class='size-3 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
        />
      </a>
    </div>
  </section>

  <section class='flex flex-col'>
    <div class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'>
      <h2 class='m-0 flex items-baseline gap-3 text-lg font-normal'>
        <span class='text-muted font-mono text-sm tracking-wide'>04</span>
        <span class='text-primary'>what i work with</span>
      </h2>
    </div>
    <div class='flex flex-col pb-0'>
      <div>
        <Stack />
      </div>
    </div>
  </section>
</Layout>
