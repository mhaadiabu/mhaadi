---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';
import { getCollection } from 'astro:content';

type PortfolioItem = Project | Package;

const projectsSection: PortfolioItem[] = [...featuredProjects, ...packages];
const firstProjectIndex = projectsSection.findIndex(
  (item) => item.type === 'project',
);

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const headingVariant = 'editorial' as const;
const idx = (n: number) => String(n).padStart(2, '0');
---

<Layout>
  {
    // hashed /_astro URLs only exist in a production build
    import.meta.env.PROD && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href="/_astro/task-thing.CZ4I6cSL_16B98y.webp"
        imagesrcset="/_astro/task-thing.CZ4I6cSL_Z2WIbL.webp 320w, /_astro/task-thing.CZ4I6cSL_16B98y.webp 640w"
        imagesizes="(min-width: 48rem) 640px, 100vw"
        fetchpriority="high"
      />
    )
  }

  {
    (
      <header class='home-hero flex flex-col gap-1.5'>
        <h1 class='text-primary text-4xl font-semibold tracking-tight sm:text-5xl'>
          haadi
        </h1>
        <p class='text-accent font-mono text-base'>
          <span class='text-muted'>&gt;</span> frontend engineer
        </p>
      </header>
    )
  }

  <div
    class='home-section flex flex-col [contain-intrinsic-size:auto_300px] [content-visibility:auto]'
  >
    <div class='home-section-inner flex flex-col gap-2.5'>
      <SectionHeading
        text='what i like to do'
        variant={headingVariant}
        index={idx(1)}
      />
      <WhatIDo />
    </div>
  </div>

  <div
    class='home-section flex w-full flex-col [contain-intrinsic-size:auto_850px] [content-visibility:auto]'
  >
    <div class='home-section-inner'>
      <SectionHeading
        text='my works'
        variant={headingVariant}
        index={idx(2)}
      />
    </div>
    <div class='home-project-list dim-list flex w-full flex-col divide-y divide-border'>
      {
        projectsSection.map((item, index) =>
          item.type === 'project' ? (
            <ProjectCard {...item} priority={index === firstProjectIndex} />
          ) : (
            <PackageCard {...item} />
          ),
        )
      }
    </div>
    <p class='home-section-inner pt-4'>
      interested in other things i&apos;ve worked on? {' '}
      <a
        href='/projects'
        data-astro-prefetch
        class='link-underline group text-secondary hover:text-primary inline-flex items-center gap-1'
      >
        check them out <Icon
          name='arrow-right'
          class='size-3.5 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
        />
      </a>
    </p>
  </div>

  <div
    class='home-section flex flex-col [contain-intrinsic-size:auto_300px] [content-visibility:auto]'
  >
    <div class='home-section-inner'>
      <SectionHeading
        text='recent writes'
        variant={headingVariant}
        index={idx(3)}
      />
    </div>
    <div class='home-blog-list blog-list border-border flex flex-col divide-y divide-border border-y'>
      {
        blogPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            data-astro-prefetch
            class='flex w-full flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 sm:px-6'
          >
            <div class='flex flex-col gap-0.5'>
              <span class='text-primary text-lg font-normal'>
                {post.data.title}
              </span>
              <span class='text-muted line-clamp-3 text-base'>
                {post.data.description}
              </span>
            </div>
            <time
              datetime={post.data.date.toISOString()}
              class='text-muted pt-1.5 whitespace-nowrap font-mono text-sm tabular-nums sm:pt-0'
            >
              {fmt(post.data.date)}
            </time>
          </a>
        ))
      }
    </div>
    <a
      href='/blog'
      data-astro-prefetch
      class='home-section-inner link-underline text-muted hover:text-primary group mt-3 inline-flex w-fit items-center gap-1.5 text-sm'
    >
      view all posts
      <Icon
        name='arrow-right'
        class='size-3 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
      />
    </a>
  </div>

  <div
    class='home-section flex flex-col [contain-intrinsic-size:auto_900px] [content-visibility:auto]'
  >
    <div class='home-section-inner'>
      <SectionHeading
        text='what i work with'
        variant={headingVariant}
        index={idx(4)}
      />
    </div>
    <div class='home-stack'>
      <Stack />
    </div>
  </div>
</Layout>
