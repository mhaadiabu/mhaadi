---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import face from '../assets/face.png';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import GitHubContributions from '../components/GitHubContributions.astro';
import { featuredProjects } from '../data/projects';
import { packages } from '../data/packages';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const reveal = {
  whatHeading: 4,
  whatList: 5,
  selectedHeading: 9,
  selectedProject: 10,
  packages: 10 + featuredProjects.length,
  workMore: 10 + featuredProjects.length + packages.length,
  writesHeading: 11 + featuredProjects.length + packages.length,
  writes: 12 + featuredProjects.length + packages.length,
  writesMore: 12 + featuredProjects.length + packages.length + blogPosts.length,
  stackHeading:
    13 + featuredProjects.length + packages.length + blogPosts.length,
  stack: 14 + featuredProjects.length + packages.length + blogPosts.length,
};
---

<Layout>
  {
    (
      <header class='grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 px-4 pt-16 pb-12 sm:px-6'>
        <div
          class='flex min-w-0 flex-col gap-1.5'
          data-page-reveal
          style='--page-reveal-index: 0'
        >
          <h1 class='text-primary text-4xl font-semibold tracking-tight sm:text-5xl'>
            haadi
          </h1>
          <p class='text-secondary font-mono text-base'>frontend engineer</p>
        </div>
        <Image
          src={face}
          alt='haadi'
          width={136}
          height={136}
          class='size-[6.8rem] rounded-full border-2 border-[#0a0a0a] bg-white object-cover sm:size-[8.5rem]'
          loading='eager'
          data-page-reveal
          style='--page-reveal-index: 1'
        />
        <nav
          class='col-span-full flex flex-wrap gap-x-4 gap-y-2 sm:col-span-1 sm:col-start-1'
          aria-label='Primary'
          data-page-reveal
          style='--page-reveal-index: 2'
        >
          <a
            href='#selected-work'
            class='link-underline text-secondary hover:text-primary inline-flex items-center gap-1 text-sm'
          >
            see selected work
            <Icon name='arrow-right' class='size-3.5 rotate-90' />
          </a>
          <a
            href='/blog'
            data-astro-prefetch
            class='link-underline text-secondary hover:text-primary inline-flex items-center gap-1 text-sm'
          >
            read the blog
            <Icon name='arrow-top-right' class='size-3.5' />
          </a>
        </nav>
        <GitHubContributions revealIndex={3} />
      </header>
    )
  }

  <section class='flex flex-col'>
    <div
      class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'
      data-page-reveal
      style={`--page-reveal-index: ${reveal.whatHeading}`}
    >
      <h2 class='m-0 text-lg font-normal'>
        <span class='text-primary'>what i like to do</span>
      </h2>
    </div>
    <div class='mx-4 pb-12 sm:mx-6'>
      <WhatIDo revealStart={reveal.whatList} />
    </div>
  </section>

  <section id='selected-work' class='flex w-full flex-col'>
    <div
      class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'
      data-page-reveal
      style={`--page-reveal-index: ${reveal.selectedHeading}`}
    >
      <h2 class='m-0 text-lg font-normal'>
        <span class='text-primary'>selected work</span>
      </h2>
    </div>
    <div class='flex w-full flex-col pb-12'>
      <div
        class='dim-list mt-6 flex w-full flex-col [&>*]:relative [&>article]:px-4 sm:[&>article]:px-6'
      >
        {
          [
            ...featuredProjects.map((project, index) => (
              <ProjectCard
                {...project}
                priority={index === 0}
                revealIndex={reveal.selectedProject + index}
              />
            )),
            ...packages.map((pkg, index) => (
              <PackageCard {...pkg} revealIndex={reveal.packages + index} />
            )),
          ]
        }
      </div>
      <a
        href='/projects'
        data-astro-prefetch
        data-page-reveal
        style={`--page-reveal-index: ${reveal.workMore}`}
        class='link-underline text-muted hover:text-primary group mx-4 mt-3 inline-flex w-fit items-center gap-1.5 text-sm sm:mx-6'
      >
        view all work
        <Icon
          name='arrow-right'
          class='size-3 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
        />
      </a>
    </div>
  </section>

  <section class='flex flex-col'>
    <div
      class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'
      data-page-reveal
      style={`--page-reveal-index: ${reveal.writesHeading}`}
    >
      <h2 class='m-0 text-lg font-normal'>
        <span class='text-primary'>recent writes</span>
      </h2>
    </div>
    <div class='flex flex-col pb-12'>
      <div
        class='home-blog-list blog-list relative flex flex-col [&>*]:relative'
      >
        {
          blogPosts.map((post, index) => (
            <a
              href={`/blog/${post.id}`}
              data-astro-prefetch
              data-page-reveal
              style={`--page-reveal-index: ${reveal.writes + index}`}
              class='flex w-full flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 sm:px-6'
            >
              <div class='flex flex-col gap-0.5'>
                <span class='text-primary text-lg font-normal'>
                  {post.data.title}
                </span>
                <span class='text-muted line-clamp-3 text-base'>
                  {post.data.description}
                </span>
              </div>
              <time
                datetime={post.data.date.toISOString()}
                class='text-muted pt-1.5 font-mono text-sm whitespace-nowrap tabular-nums sm:pt-0'
              >
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        }
      </div>
      <a
        href='/blog'
        data-astro-prefetch
        data-page-reveal
        style={`--page-reveal-index: ${reveal.writesMore}`}
        class='link-underline text-muted hover:text-primary group mx-4 mt-3 inline-flex w-fit items-center gap-1.5 text-sm sm:mx-6'
      >
        view all posts
        <Icon
          name='arrow-right'
          class='size-3 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
        />
      </a>
    </div>
  </section>

  <section class='flex flex-col'>
    <div
      class='home-section-head relative px-4 pt-11 pb-3 sm:px-6'
      data-page-reveal
      style={`--page-reveal-index: ${reveal.stackHeading}`}
    >
      <h2 class='m-0 text-lg font-normal'>
        <span class='text-primary'>what i work with</span>
      </h2>
    </div>
    <div class='flex flex-col pb-0'>
      <div>
        <Stack revealStart={reveal.stack} />
      </div>
    </div>
  </section>
</Layout>
