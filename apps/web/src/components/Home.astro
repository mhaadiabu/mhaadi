---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';
import { getCollection } from 'astro:content';

type PortfolioItem = Project | Package;

const projectsSection: PortfolioItem[] = [...featuredProjects, ...packages];
const firstProjectIndex = projectsSection.findIndex(
  (item) => item.type === 'project',
);

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const headingVariant = 'editorial' as const;
const idx = (n: number) => String(n).padStart(2, '0');
---

<Layout>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/_astro/task-thing.BRPFQif3_EUqFM.webp"
    imagesrcset="/_astro/task-thing.BRPFQif3_ZtDqDx.webp 320w, /_astro/task-thing.BRPFQif3_EUqFM.webp 640w"
    imagesizes="(min-width: 48rem) 640px, 100vw"
    fetchpriority="high"
  />

  {
    (
      <header class='flex flex-col gap-1.5'>
        <h1 class='text-primary text-4xl font-semibold tracking-tight sm:text-5xl'>
          haadi
        </h1>
        <p class='text-accent font-mono text-sm'>
          <span class='text-muted'>&gt;</span> frontend engineer
        </p>
      </header>
    )
  }

  <div
    class='flex flex-col gap-2.5 pt-10 [contain-intrinsic-size:auto_300px] [content-visibility:auto]'
  >
    <SectionHeading
      text='what i like to do'
      variant={headingVariant}
      index={idx(1)}
    />
    <WhatIDo />
  </div>

  <div
    class='dim-list flex w-full flex-col gap-4 pt-10 [contain-intrinsic-size:auto_850px] [content-visibility:auto]'
  >
    <SectionHeading
      text='my works'
      variant={headingVariant}
      index={idx(2)}
    />
    {
      projectsSection.map((item, index) =>
        item.type === 'project' ? (
          <ProjectCard {...item} priority={index === firstProjectIndex} />
        ) : (
          <PackageCard {...item} />
        ),
      )
    }
    <p>
      interested in other things i&apos;ve worked on? {' '}
      <a
        href='/projects'
        data-astro-prefetch
        class='group text-secondary hover:text-primary inline-flex items-center gap-1 transition-colors duration-(--duration-fast)'
      >
        check them out <Icon
          name='arrow-right'
          class='size-3.5 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
        />
      </a>
    </p>
  </div>

  <div
    class='flex flex-col gap-2.5 pt-10 [contain-intrinsic-size:auto_300px] [content-visibility:auto]'
  >
    <SectionHeading
      text='recent writes'
      variant={headingVariant}
      index={idx(3)}
      action={(
        <a
          href='/blog'
          class='text-muted hover:text-primary group flex items-center gap-1.5 font-normal text-xs tracking-normal transition-colors duration-[var(--duration-fast)]'
        >
          view all
          <Icon
            name='arrow-right'
            class='size-3 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5'
          />
        </a>
      )}
    />
    <div class='blog-list flex flex-col gap-1'>
      {
        blogPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            data-astro-prefetch
            class='hover:bg-bg-secondary/70 -mx-3 flex w-full items-baseline justify-between gap-4 rounded-lg px-3 py-2.5 transition-[opacity,background-color] duration-[var(--duration-fast)] ease-[var(--ease-in-out)]'
          >
            <div class='flex flex-col gap-0.5'>
              <span class='text-primary text-base font-normal'>
                {post.data.title}
              </span>
              <span class='text-muted line-clamp-3 text-sm'>
                {post.data.description}
              </span>
            </div>
            <time
              datetime={post.data.date.toISOString()}
              class='text-muted whitespace-nowrap font-mono text-xs tabular-nums'
            >
              {fmt(post.data.date)}
            </time>
          </a>
        ))
      }
    </div>
  </div>

  <div
    class='flex flex-col gap-2.5 pt-10 [contain-intrinsic-size:auto_900px] [content-visibility:auto]'
  >
    <SectionHeading
      text='what i work with'
      variant={headingVariant}
      index={idx(4)}
    />
    <Stack />
  </div>
</Layout>
