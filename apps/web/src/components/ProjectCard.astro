---
import { Icon } from 'astro-icon/components';
import { iconLabels } from '../icons/labels';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata | string;
  stack: string[];
  href?: string;
  github?: string;
  disabled?: boolean;
  priority?: boolean;
}

const {
  title,
  description,
  image,
  stack,
  href,
  github,
  disabled = false,
  priority = false,
} = Astro.props;
---

<article
  class:list={[
    'group/project flex w-full flex-col gap-4 py-5 transition-opacity duration-[var(--duration-fast)] ease-[var(--ease-in-out)] sm:flex-row',
    disabled && 'cursor-not-allowed',
  ]}
>
  {
    disabled ? (
      <div class='relative aspect-video shrink-0 overflow-hidden sm:w-36'>
        <Image
          src={image}
          alt={title}
          width={640}
          height={360}
          layout='constrained'
          widths={[320, 640]}
          sizes='(min-width: 48rem) 640px, 100vw'
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          class='blur-sm h-full w-full object-cover'
        />
        <div class='bg-bg/70 absolute inset-0 flex items-center justify-center'>
          <span class='text-muted text-xs font-medium tracking-wide'>
            coming soon
          </span>
        </div>
      </div>
    ) : (
      <button
        type='button'
        data-lightbox
        aria-label={`Open ${title} screenshot fullscreen`}
        class='group/lightbox relative aspect-video shrink-0 cursor-zoom-in overflow-hidden sm:w-36'
      >
        <Image
          src={image}
          alt={title}
          width={640}
          height={360}
          layout='constrained'
          widths={[320, 640]}
          sizes='(min-width: 48rem) 640px, 100vw'
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          class='group-hover/project:scale-[1.03] h-full w-full object-cover transition-transform duration-[var(--duration-medium)] ease-[var(--ease-smooth-out)]'
        />
      </button>
    )
  }

<script>
  // fullscreen lightbox for project screenshots
  const lightbox = document.createElement('div');
  lightbox.className =
    'fixed inset-0 z-50 hidden items-center justify-center bg-bg/90 p-4 backdrop-blur-sm';
  lightbox.innerHTML = '<img class="max-h-full max-w-full rounded-lg" />';
  document.body.append(lightbox);

  const lightboxImg = lightbox.querySelector('img')!;

  const closeLightbox = () => {
    lightbox.classList.replace('flex', 'hidden');
    lightboxImg.src = '';
  };

  lightbox.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => {
    button.addEventListener('click', () => {
      const img = button.querySelector('img');
      if (!img) return;
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.replace('hidden', 'flex');
    });
  });
</script>

  <div class='flex min-w-0 flex-1 flex-col gap-1.5'>
    <div class='flex items-baseline justify-between gap-4'>
      <h3 class='text-primary text-base font-normal'>{title}</h3>
      <div class='flex shrink-0 gap-2'>
        {
          github && !disabled && (
            <a
              href={github}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary transition-colors duration-[var(--duration-fast)]'
            >
              <Icon name='github-logo' class='size-4' />
              <span class='sr-only'>GitHub repository</span>
            </a>
          )
        }
        {
          href && !disabled && (
            <a
              href={href}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary group/link transition-colors duration-[var(--duration-fast)]'
            >
              <Icon
                name='arrow-top-right'
                class='size-4 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5'
              />
              <span class='sr-only'>View project</span>
            </a>
          )
        }
      </div>
    </div>

    <p class='text-muted line-clamp-2 text-sm'>{description}</p>

    <div class='flex flex-wrap gap-2 pt-1'>
      {
        stack.map((tech) => (
          <div
            class='text-secondary hover:text-primary flex items-center gap-1.5 transition-colors duration-[var(--duration-fast)]'
            title={iconLabels[tech] ?? tech}
          >
            <Icon name={tech} class='size-4' />
          </div>
        ))
      }
    </div>
  </div>
</article>
