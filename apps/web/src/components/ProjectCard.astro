---
import { Icon } from 'astro-icon/components';
import { iconLabels } from '../icons/labels';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Stack } from '../data/types';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata | string;
  stack: Stack[];
  href?: string;
  github?: string;
  disabled?: boolean;
  revealIndex?: number;
}

const {
  title,
  description,
  image,
  stack,
  href,
  github,
  disabled = false,
  revealIndex,
} = Astro.props;
---

<article
  class:list={[
    'group/project flex w-full flex-col gap-4 py-5 sm:flex-row',
    disabled && 'cursor-not-allowed',
  ]}
  data-page-reveal={revealIndex !== undefined ? true : undefined}
  style={revealIndex !== undefined
    ? `--page-reveal-index: ${revealIndex}`
    : undefined}
>
  {
    disabled ? (
      <div class='relative shrink-0 overflow-hidden sm:w-36'>
        <Image
          src={image}
          alt={title}
          layout='constrained'
          widths={[320, 640, 1280]}
          sizes='(min-width: 48rem) 640px, 100vw'
          loading='lazy'
          fetchpriority='auto'
          class='w-full rounded-none object-cover blur-sm'
        />
        <div class='bg-bg/70 absolute inset-0 flex items-center justify-center'>
          <span class='text-muted text-sm font-medium tracking-wide'>
            coming soon
          </span>
        </div>
      </div>
    ) : (
      <button
        type='button'
        data-lightbox
        aria-haspopup='dialog'
        aria-label={`Open ${title} screenshot fullscreen`}
        class='group/lightbox relative shrink-0 cursor-pointer sm:w-36'
      >
        <Image
          src={image}
          alt={title}
          layout='constrained'
          widths={[320, 640, 1280]}
          sizes='(min-width: 48rem) 640px, 100vw'
          loading='lazy'
          fetchpriority='auto'
          class='w-full rounded-none object-cover opacity-80 transition-opacity duration-[var(--duration-very-slow)] ease-[var(--ease-out)] group-hover/lightbox:opacity-100 group-hover/project:opacity-100'
        />
      </button>
    )
  }

  <script>
    // fullscreen lightbox for project screenshots
    // delegated so buttons keep working after view-transition DOM swaps
    let lightbox: HTMLElement | null = null;
    let activeTrigger: HTMLElement | null = null;

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.replace('flex', 'hidden');
      lightbox.setAttribute('aria-hidden', 'true');
      lightbox.querySelector('img')?.removeAttribute('src');
      document.body.style.overflow = '';
      activeTrigger?.focus();
      activeTrigger = null;
    };

    document.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-lightbox]',
      );
      if (!button) return;

      if (!lightbox) {
        lightbox = document.createElement('div');
        lightbox.className =
          'fixed inset-0 z-50 hidden items-center justify-center bg-bg/90 p-4 backdrop-blur-sm';
        lightbox.setAttribute('role', 'dialog');
        lightbox.setAttribute('aria-modal', 'true');
        lightbox.setAttribute('aria-label', 'Screenshot preview');
        lightbox.setAttribute('aria-hidden', 'true');
        lightbox.tabIndex = -1;
        lightbox.innerHTML =
          '<button type="button" data-lightbox-close class="text-primary hover:text-secondary absolute top-4 right-4 flex size-11 items-center justify-center rounded-full bg-bg-secondary text-2xl leading-none transition-colors" aria-label="Close screenshot">&times;</button><img class="max-h-full w-auto max-w-full rounded-lg object-contain" />';
        lightbox.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          if (target === lightbox || target.closest('[data-lightbox-close]')) {
            closeLightbox();
          }
        });
        document.body.append(lightbox);
      }

      const img = button.querySelector('img');
      if (!img) return;
      const lightboxImg = lightbox.querySelector('img')!;
      // currentSrc is the thumbnail-sized variant; the lightbox wants the largest
      const largest =
        img.srcset
          .split(',')
          .map((entry) => entry.trim().split(/\s+/))
          .sort(
            (a, b) => parseInt(b[1] ?? '0', 10) - parseInt(a[1] ?? '0', 10),
          )[0]?.[0] ?? img.src;
      lightboxImg.src = largest;
      lightboxImg.alt = img.alt;
      activeTrigger = button;
      lightbox.setAttribute('aria-hidden', 'false');
      lightbox.classList.replace('hidden', 'flex');
      // lock page scroll while the modal is open
      document.body.style.overflow = 'hidden';
      lightbox
        .querySelector<HTMLButtonElement>('[data-lightbox-close]')
        ?.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox || lightbox.classList.contains('hidden')) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'Tab') {
        event.preventDefault();
        lightbox
          .querySelector<HTMLButtonElement>('[data-lightbox-close]')
          ?.focus();
      }
    });
  </script>

  <div class='flex min-w-0 flex-1 flex-col gap-1.5'>
    <div class='flex items-baseline justify-between gap-4'>
      <h3 class='text-primary text-lg font-normal'>{title}</h3>
      <div class='flex shrink-0 gap-0'>
        {
          github && !disabled && (
            <a
              href={github}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary inline-flex size-11 shrink-0 items-center justify-center transition-colors duration-[var(--duration-fast)]'
            >
              <Icon name='github-logo' class='size-4' />
              <span class='sr-only'>GitHub repository</span>
            </a>
          )
        }
        {
          href && !disabled && (
            <a
              href={href}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary group/link inline-flex size-11 shrink-0 items-center justify-center transition-colors duration-[var(--duration-fast)]'
            >
              <Icon
                name='arrow-top-right'
                class='size-4 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5'
              />
              <span class='sr-only'>View project</span>
            </a>
          )
        }
      </div>
    </div>

    <p class='text-muted line-clamp-2 text-base'>{description}</p>

    <div class='flex flex-wrap gap-2 pt-1'>
      {
        stack.map((tech) => (
          <div
            class='text-secondary hover:text-primary flex items-center gap-1.5 transition-colors duration-[var(--duration-fast)]'
            data-tooltip={iconLabels[tech] ?? tech}
            role='img'
            aria-label={iconLabels[tech] ?? tech}
          >
            <Icon name={tech} class='size-4' />
          </div>
        ))
      }
    </div>
  </div>
</article>
