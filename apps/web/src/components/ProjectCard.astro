---
import { Icon } from 'astro-icon/components';
import { iconLabels } from '../icons/labels';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Stack } from '../data/types';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata | string;
  stack: Stack[];
  href?: string;
  github?: string;
  disabled?: boolean;
  revealIndex?: number;
}

const {
  title,
  description,
  image,
  stack,
  href,
  github,
  disabled = false,
  revealIndex,
} = Astro.props;

// unique shared-element name so the thumbnail can morph into the lightbox
const shotName = `shot-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  class:list={[
    'group/project flex w-full flex-col gap-4 py-5 sm:flex-row',
    disabled && 'cursor-not-allowed',
  ]}
  data-page-reveal={revealIndex !== undefined ? true : undefined}
  style={revealIndex !== undefined
    ? `--page-reveal-index: ${revealIndex}`
    : undefined}
>
  {
    disabled ? (
      <div class='relative shrink-0 overflow-hidden sm:w-36'>
        <Image
          src={image}
          alt={title}
          layout='constrained'
          widths={[320, 640, 1280]}
          sizes='(min-width: 48rem) 640px, 100vw'
          loading='lazy'
          fetchpriority='auto'
          class='w-full rounded-none object-cover blur-sm'
        />
        <div class='bg-bg/70 absolute inset-0 flex items-center justify-center'>
          <span class='text-muted text-sm font-medium tracking-wide'>
            coming soon
          </span>
        </div>
      </div>
    ) : (
      <button
        type='button'
        data-lightbox
        data-lightbox-name={shotName}
        aria-haspopup='dialog'
        aria-label={`Open ${title} screenshot fullscreen`}
        class='group/lightbox relative shrink-0 cursor-pointer sm:w-36'
      >
        <Image
          src={image}
          alt={title}
          layout='constrained'
          widths={[320, 640, 1280]}
          sizes='(min-width: 48rem) 640px, 100vw'
          loading='lazy'
          fetchpriority='auto'
          class='w-full rounded-none object-cover opacity-80 transition-opacity duration-[var(--duration-very-slow)] ease-[var(--ease-out)] group-hover/lightbox:opacity-100 group-hover/project:opacity-100'
        />
      </button>
    )
  }

  <script>
    // fullscreen lightbox for project screenshots
    // delegated so buttons keep working after view-transition DOM swaps.
    // open/close morphs between thumbnail and lightbox via a same-page
    // view transition; reduced motion or missing API falls back to instant.
    function setupLightbox() {
      // guarded: the script re-runs after client-side navigation, so only
      // the first instance wires up the delegated listeners.
      if (document.documentElement.dataset.lightboxReady) return;
      document.documentElement.dataset.lightboxReady = 'true';
      let lightbox: HTMLElement | null = null;
      let activeTrigger: HTMLElement | null = null;

      const calmMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        typeof document.startViewTransition !== 'function';

      const ensureLightbox = () => {
        if (lightbox) return lightbox;
        lightbox = document.createElement('div');
        lightbox.className =
          'fixed inset-0 z-50 hidden items-center justify-center bg-bg/90 p-4 backdrop-blur-sm';
        lightbox.setAttribute('role', 'dialog');
        lightbox.setAttribute('aria-modal', 'true');
        lightbox.setAttribute('aria-label', 'Screenshot preview');
        lightbox.setAttribute('aria-hidden', 'true');
        lightbox.tabIndex = -1;
        lightbox.innerHTML =
          '<button type="button" data-lightbox-close class="text-primary hover:text-secondary absolute top-4 right-4 flex size-11 items-center justify-center rounded-full bg-bg-secondary text-2xl leading-none transition-colors" aria-label="Close screenshot">&times;</button><img class="max-h-full w-auto max-w-full rounded-lg object-contain" />';
        lightbox.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          if (target === lightbox || target.closest('[data-lightbox-close]')) {
            closeLightbox();
          }
        });
        document.body.append(lightbox);
        return lightbox;
      };

      const lightboxImg = () => ensureLightbox().querySelector('img')!;

      // wait for the full-size image (bounded) so the new snapshot isn't empty
      const awaitFullImage = (img: HTMLImageElement) => {
        if (img.complete && img.naturalWidth > 0) return Promise.resolve();
        return Promise.race([
          new Promise((resolve) => {
            img.addEventListener('load', resolve, { once: true });
            img.addEventListener('error', resolve, { once: true });
          }),
          new Promise((resolve) => window.setTimeout(resolve, 700)),
        ]);
      };

      const setShotNames = (
        trigger: HTMLElement | null,
        name: string | null,
      ) => {
        const img = lightboxImg();
        if (trigger) {
          if (name) trigger.style.viewTransitionName = name;
          else trigger.style.removeProperty('view-transition-name');
        }
        if (name) img.style.viewTransitionName = name;
        else img.style.removeProperty('view-transition-name');
      };

      const openLightbox = (button: HTMLElement) => {
        const box = ensureLightbox();
        const img = button.querySelector('img');
        if (!img) return;
        const fullImg = lightboxImg();
        // currentSrc is the thumbnail-sized variant; the lightbox wants the largest
        const largest =
          img.srcset
            .split(',')
            .map((entry) => entry.trim().split(/\s+/))
            .sort(
              (a, b) => parseInt(b[1] ?? '0', 10) - parseInt(a[1] ?? '0', 10),
            )[0]?.[0] ?? img.src;
        fullImg.src = largest;
        fullImg.alt = img.alt;
        activeTrigger = button;

        const show = () => {
          button.style.removeProperty('view-transition-name');
          box.setAttribute('aria-hidden', 'false');
          box.classList.replace('hidden', 'flex');
          // lock page scroll while the modal is open
          document.body.style.overflow = 'hidden';
          box
            .querySelector<HTMLButtonElement>('[data-lightbox-close]')
            ?.focus();
        };

        const name = button.getAttribute('data-lightbox-name');
        if (!name || calmMotion()) {
          show();
          return;
        }
        // name only the thumbnail until the transition starts: a display:none
        // element with the same name still counts as a duplicate and kills
        // the pair. the image takes the name over inside the update callback.
        button.style.viewTransitionName = name;
        void awaitFullImage(fullImg).then(() => {
          document.startViewTransition(() => {
            fullImg.style.viewTransitionName = name;
            show();
          });
        });
      };

      const closeLightbox = () => {
        const box = lightbox;
        const trigger = activeTrigger;
        if (!box || box.classList.contains('hidden')) return;

        const hide = () => {
          // hand the name back to the thumbnail for the return flight
          if (trigger) {
            const name = trigger.getAttribute('data-lightbox-name');
            if (name) trigger.style.viewTransitionName = name;
          }
          lightboxImg().style.removeProperty('view-transition-name');
          box.setAttribute('aria-hidden', 'true');
          box.classList.replace('flex', 'hidden');
          document.body.style.overflow = '';
          trigger?.focus();
          activeTrigger = null;
        };

        if (calmMotion() || !trigger?.getAttribute('data-lightbox-name')) {
          hide();
          lightboxImg().removeAttribute('src');
          setShotNames(trigger, null);
          return;
        }
        const transition = document.startViewTransition(hide);
        void transition.finished.finally(() => {
          lightboxImg().removeAttribute('src');
          setShotNames(trigger, null);
        });
      };

      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>(
          '[data-lightbox]',
        );
        if (!button) return;
        openLightbox(button);
      });

      document.addEventListener('keydown', (event) => {
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'Tab') {
          event.preventDefault();
          lightbox
            .querySelector<HTMLButtonElement>('[data-lightbox-close]')
            ?.focus();
        }
      });
    }

    setupLightbox();
  </script>

  <div class='flex min-w-0 flex-1 flex-col gap-1.5'>
    <div class='flex items-baseline justify-between gap-4'>
      <h3 class='text-primary text-lg font-normal'>{title}</h3>
      <div class='flex shrink-0 gap-0'>
        {
          github && !disabled && (
            <a
              href={github}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary inline-flex size-11 shrink-0 items-center justify-center transition-colors duration-[var(--duration-fast)]'
            >
              <Icon name='github-logo' class='size-4' />
              <span class='sr-only'>GitHub repository</span>
            </a>
          )
        }
        {
          href && !disabled && (
            <a
              href={href}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary group/link inline-flex size-11 shrink-0 items-center justify-center transition-colors duration-[var(--duration-fast)]'
            >
              <Icon
                name='arrow-top-right'
                class='size-4 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5'
              />
              <span class='sr-only'>View project</span>
            </a>
          )
        }
      </div>
    </div>

    <p class='text-muted line-clamp-2 text-base'>{description}</p>

    <div class='flex flex-wrap gap-2 pt-1'>
      {
        stack.map((tech) => (
          <div
            class='text-secondary hover:text-primary flex items-center gap-1.5 transition-colors duration-[var(--duration-fast)]'
            data-tooltip={iconLabels[tech] ?? tech}
            role='img'
            aria-label={iconLabels[tech] ?? tech}
          >
            <Icon name={tech} class='size-4' />
          </div>
        ))
      }
    </div>
  </div>
</article>
