---
import { Icon } from 'astro-icon/components';
import { iconLabels } from '../icons/labels';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata | string;
  stack: string[];
  href?: string;
  github?: string;
  disabled?: boolean;
  priority?: boolean;
}

const {
  title,
  description,
  image,
  stack,
  href,
  github,
  disabled = false,
  priority = false,
} = Astro.props;
---

<article
  class:list={[
    'group/project bg-bg-secondary shadow-card flex w-full flex-col gap-3 rounded-lg p-4 transition-opacity duration-[var(--duration-fast)] ease-[var(--ease-in-out)]',
    disabled && 'cursor-not-allowed',
  ]}
>
  <div class='relative aspect-video overflow-hidden rounded-md'>
    <Image
      src={image}
      alt={title}
      width={640}
      height={360}
      layout='constrained'
      widths={[320, 640]}
      sizes='(min-width: 48rem) 640px, 100vw'
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class:list={[
        'h-full w-full object-cover',
        !disabled && 'group-hover/project:scale-[1.03] transition-transform duration-[var(--duration-medium)] ease-[var(--ease-smooth-out)]',
        disabled && 'blur-sm',
      ]}
    />
    {
      disabled && (
        <div class='bg-bg-secondary/70 absolute inset-0 flex items-center justify-center'>
          <span class='text-muted border-border bg-bg-secondary rounded-md border px-2 py-1 text-xs font-medium tracking-wider uppercase'>
            Coming Soon
          </span>
        </div>
      )
    }
  </div>

  <div class='flex flex-col gap-2'>
    <div class='flex items-center justify-between'>
      <h3 class='text-primary text-base font-normal'>{title}</h3>
      <div class='flex gap-2'>
        {
          github && !disabled && (
            <a
              href={github}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary transition-colors duration-[var(--duration-fast)]'
            >
              <Icon name='github-logo' class='size-4' />
              <span class='sr-only'>GitHub repository</span>
            </a>
          )
        }
        {
          href && !disabled && (
            <a
              href={href}
              target='_blank'
              rel='noopener noreferrer'
              class='text-muted hover:text-primary group/link transition-colors duration-[var(--duration-fast)]'
            >
              <Icon
                name='arrow-top-right'
                class='size-4 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5'
              />
              <span class='sr-only'>View project</span>
            </a>
          )
        }
      </div>
    </div>

    <p class='text-muted line-clamp-2 text-sm'>{description}</p>

    <div class='flex flex-wrap gap-2 pt-1'>
      {
        stack.map((tech) => (
          <div
            class='text-secondary hover:text-primary flex items-center gap-1.5 transition-colors duration-[var(--duration-fast)]'
            title={iconLabels[tech] ?? tech}
          >
            <Icon name={tech} class='size-4' />
          </div>
        ))
      }
    </div>
  </div>
</article>
