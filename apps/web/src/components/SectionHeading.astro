---
interface Props {
  text: string;
  variant?: 'slash' | 'arrow' | 'line' | 'pill' | 'edge' | 'bracket' | 'dot';
}

const { text, variant = 'slash' } = Astro.props;
---

{
  variant === 'slash' && (
    <h4 class="text-secondary font-medium">
      <span class="text-secondary/30">//</span> {text}
    </h4>
  )
}

{
  variant === 'arrow' && (
    <h4 class="text-secondary font-medium">
      <span class="text-secondary/30">▸</span> {text}
    </h4>
  )
}

{
  variant === 'line' && (
    <div class="flex items-center gap-3">
      <h4 class="text-secondary font-medium whitespace-nowrap">{text}</h4>
      <span class="bg-border h-px flex-1" />
    </div>
  )
}

{
  variant === 'pill' && (
    <h4 class="text-secondary border-border bg-bg-secondary inline-flex items-center rounded-full border px-3 py-0.5 text-xs font-medium tracking-wide">
      {text}
    </h4>
  )
}

{
  variant === 'edge' && (
    <div class="section-heading-edge-wrapper flex flex-col gap-1.5">
      <h4 class="section-heading-edge text-secondary relative">
        {text}
      </h4>
    </div>
  )
}

{
  variant === 'bracket' && (
    <h4 class="section-heading-bracket text-secondary relative">
      {text}
    </h4>
  )
}

{
  variant === 'dot' && (
    <h4 class="section-heading-dot text-secondary relative">
      <span class="sr-only">✦</span>
      {text}
    </h4>
  )
}

<style>
  .section-heading-edge-wrapper::after {
    content: '';
    height: 1px;
    width: 100%;
    background: var(--color-border);
  }

  .section-heading-edge {
    padding-left: 1rem;
  }

  .section-heading-edge::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    bottom: 3px;
    width: 3px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .section-heading-bracket {
    padding-left: 1rem;
  }

  .section-heading-bracket::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    bottom: 3px;
    width: 3px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .section-heading-bracket::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 3px;
    height: 3px;
    width: 0.75rem;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .section-heading-dot {
    padding-left: 1rem;
  }

  .section-heading-dot::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    bottom: 3px;
    width: 3px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .section-heading-dot::after {
    content: '';
    position: absolute;
    top: -2px;
    left: -1px;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 6px 1px var(--color-accent);
  }
</style>
