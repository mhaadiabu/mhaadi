---
interface Props {
  action?: any;
  text: string;
  /** mono section index, e.g. '01' — rendered before the text */
  index?: string;
  variant?:
    | 'slash'
    | 'arrow'
    | 'line'
    | 'pill'
    | 'edge'
    | 'bracket'
    | 'dot'
    | 'editorial';
}

const { action, text, index, variant = 'slash' } = Astro.props;
---

{
  variant === 'editorial' && (
    <div class='flex items-baseline gap-3'>
      {index && <span class='text-accent font-mono text-sm'>{index}</span>}
      <h2 class='text-secondary text-base font-semibold tracking-wide'>
        {text}
      </h2>
      <span class='bg-border h-px flex-1' />
    </div>
  )
}

{
  variant === 'slash' && (
    <h2 class='text-secondary flex items-baseline gap-2.5 font-medium'>
      {index && <span class='text-accent font-mono text-sm'>{index}</span>}
      <span class='text-secondary/30'>//</span> {text}
    </h2>
  )
}

{
  variant === 'line' && (
    <div class='flex items-center gap-3'>
      {index && <span class='text-accent font-mono text-sm'>{index}</span>}
      <h2 class='text-secondary font-medium whitespace-nowrap'>{text}</h2>
      <span class='bg-border h-px flex-1' />
    </div>
  )
}

{
  variant === 'arrow' && (
    <h2 class='text-secondary font-medium'>
      <span class='text-secondary/30'>▸</span> {text}
    </h2>
  )
}

{
  variant === 'pill' && (
    <h2 class='text-secondary border-border bg-bg-secondary inline-flex items-center rounded-full border px-3 py-0.5 text-sm font-medium tracking-wide'>
      {text}
    </h2>
  )
}

{
  variant === 'edge' && (
    <div class="after:bg-border flex flex-col gap-1.5 after:h-px after:w-full after:content-['']">
      <h2 class="text-secondary before:bg-accent relative pl-4 before:absolute before:top-[3px] before:bottom-[3px] before:left-0 before:w-[3px] before:rounded-[1px] before:content-['']">
        <div class='flex w-full items-baseline justify-between'>
          {text}
          {action}
        </div>
      </h2>
    </div>
  )
}

{
  variant === 'bracket' && (
    <h2 class="text-secondary before:bg-accent after:bg-accent relative pl-4 before:absolute before:top-[3px] before:bottom-[3px] before:left-0 before:w-[3px] before:rounded-[1px] before:content-[''] after:absolute after:bottom-[3px] after:left-[3px] after:h-[3px] after:w-3 after:rounded-[1px] after:content-['']">
      {text}
    </h2>
  )
}

{
  variant === 'dot' && (
    <h2 class="text-secondary before:bg-accent after:bg-accent relative pl-4 before:absolute before:top-[3px] before:bottom-[3px] before:left-0 before:w-[3px] before:rounded-[1px] before:content-[''] after:absolute after:top-[-2px] after:left-[-1px] after:size-[5px] after:rounded-full after:shadow-[0_0_6px_1px_var(--color-accent)] after:content-['']">
      <span class='sr-only'>✦</span>
      {text}
    </h2>
  )
}
