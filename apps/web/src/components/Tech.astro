---
import { Icon } from 'astro-icon/components';
import { tools } from '../data/tools';
---

<section class="tech-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
  {
    tools.map(({ icon, name }, i) => {
      const hue = (i * 47 + 180) % 360;
      return (
        <div
          class="tech-cell relative flex flex-col items-center gap-1.5 border border-border p-3 transition-colors duration-300"
          style={`--hue: ${hue}`}
        >
          <Icon name={icon} class="text-primary size-8" />
          <span class="text-muted text-xs">{name}</span>
        </div>
      );
    })
  }
</section>

<style>
  .tech-grid {
    overflow: clip;
  }

  .tech-cell {
    margin-right: -1px;
    margin-bottom: -1px;
  }

  .tech-cell:hover {
    background: hsl(var(--hue) 50% 50% / 0.08);
    border-color: hsl(var(--hue) 50% 50% / 0.5);
    z-index: 1;
  }
</style>
