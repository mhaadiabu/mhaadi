---
import { Icon } from 'astro-icon/components';
import { tools } from '../data/tools';
---

<section class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
  {
    tools.map(({ icon, name }, i) => {
      const hue = (i * 47 + 180) % 360;
      return (
        <div
          class="flex flex-col items-center gap-1.5 rounded-lg border border-transparent p-3 transition-colors duration-300"
          style={`--hue: ${hue}`}
        >
          <Icon name={icon} class="text-primary size-8" />
          <span class="text-muted text-xs">{name}</span>
        </div>
      );
    })
  }
</section>

<style>
  .flex {
    &:hover {
      background: hsl(var(--hue) 50% 50% / 0.08);
      border-color: hsl(var(--hue) 50% 50% / 0.3);
    }
  }
</style>
