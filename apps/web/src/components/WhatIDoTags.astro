---
// Option 3: Animated Tags — pill-shaped items that slide in
---

<div class="wido-tags flex flex-wrap gap-2">
  {
    [
      'build web & mobile apps',
      'obsess over AI',
      'read code and docs (a lot)',
      'refactor for fun',
    ].map((activity, i) => (
      <span
        class="border-border bg-bg-secondary text-muted inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs opacity-0"
        style={`--i: ${i}`}
      >
        {activity}
      </span>
    ))
  }
</div>

<style>
  .wido-tags > span {
    animation: tag-in 0.35s ease-out calc(var(--i) * 0.12s) forwards;
  }

  @keyframes tag-in {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .wido-tags > span:hover {
    border-color: var(--color-secondary);
    background: var(--color-bg-secondary);
  }
</style>
