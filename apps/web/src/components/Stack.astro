---
import { Icon } from 'astro-icon/components';
import { stack, type StackItemCategory } from '../data/stack';

const groups: { label: string; categories: StackItemCategory[] }[] = [
  { label: 'language', categories: ['language'] },
  { label: 'frontend', categories: ['frontend'] },
  { label: 'data & services', categories: ['backend', 'database', 'orm', 'service'] },
  { label: 'tooling & design', categories: ['tooling', 'design'] },
];

const itemsFor = ({ categories }: { categories: StackItemCategory[] }) =>
  stack.filter((item) => categories.includes(item.category));
---

<div class="stack-rows">
  {groups.map((group) => (
    <div class="stack-row flex flex-col gap-2 px-4 py-4 sm:flex-row sm:items-center sm:gap-6 sm:px-6">
      <h3 class="text-muted font-mono text-xs tracking-wide w-full shrink-0 sm:w-28">{group.label}</h3>
      <div class="flex flex-wrap gap-2">
        {itemsFor(group).map(({ name, icon }) => (
          <span class="border-border text-muted pointer-events-none inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1">
            <Icon name={icon} class="size-3.5 shrink-0" />
            <span class="text-xs">{name}</span>
          </span>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .stack-row + .stack-row {
    border-top: 1px solid var(--theme-border);
  }
</style>
