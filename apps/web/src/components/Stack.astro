---
import { Icon } from 'astro-icon/components';
import { stack } from '../data/stack';
---

<section class='bg-border grid grid-cols-2 gap-px sm:grid-cols-4'>
  {
    stack.map(({ icon, name }) => (
      <div class='bg-bg text-secondary hover:bg-bg-secondary relative flex min-w-0 items-center gap-2.5 px-4 py-3 transition-colors duration-[var(--duration-fast)] sm:px-5'>
        <Icon name={icon} class='text-secondary size-5 shrink-0' />
        <span class='truncate text-sm'>{name}</span>
      </div>
    ))
  }
</section>
