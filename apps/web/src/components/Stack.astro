---
import { Icon } from 'astro-icon/components';
import { stack, type StackItemCategory } from '../data/stack';

interface Props {
  revealStart?: number;
}

const { revealStart = 0 } = Astro.props;

const groups: { label: string; categories: StackItemCategory[] }[] = [
  { label: 'language', categories: ['language'] },
  { label: 'frontend', categories: ['frontend'] },
  {
    label: 'data & services',
    categories: ['backend', 'database', 'orm', 'service'],
  },
  { label: 'tooling & design', categories: ['tooling', 'design'] },
];

const itemsFor = ({ categories }: { categories: StackItemCategory[] }) =>
  stack.filter((item) => categories.includes(item.category));
---

<div class='divide-border divide-y'>
  {
    groups.map((group, index) => (
      <div
        class='flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:gap-6 sm:px-6'
        data-page-reveal
        style={`--page-reveal-index: ${revealStart + index}`}
      >
        <h3 class='text-muted m-0 w-full shrink-0 font-mono text-xs tracking-wide sm:w-36'>
          {group.label}
        </h3>
        <div class='m-0 flex flex-wrap gap-2'>
          {itemsFor(group).map(({ name, icon }) => (
            <span class='border-border text-muted hover:bg-muted/10 cursor-default inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 transition-colors duration-(--duration-fast)'>
              <Icon name={icon} class='size-4 shrink-0' />
              <span class='text-xs'>{name}</span>
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>
