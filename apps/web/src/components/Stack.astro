---
import { Icon } from 'astro-icon/components';
import { stack } from '../data/stack';

interface Props {
  variant?: 'grid' | 'quiet' | 'mono';
}

const { variant = 'grid' } = Astro.props;
---

{
  variant === 'grid' && (
    <section class='grid grid-cols-3 lg:grid-cols-4'>
      {stack.map(({ icon, name }, i) => {
        const hue = (i * 47 + 180) % 360;
        return (
          <div
            class='relative flex flex-col items-center gap-1.5 rounded-md p-3 transition-colors duration-[var(--duration-fast)] hover:bg-[hsl(var(--hue)_50%_50%/0.08)]'
            style={`--hue: ${hue}`}
          >
            <Icon name={icon} class='text-primary size-8' />
            <span class='text-muted text-xs'>{name}</span>
          </div>
        );
      })}
    </section>
  )
}

{
  variant === 'quiet' && (
    <section class='grid grid-cols-4 lg:grid-cols-6'>
      {stack.map(({ icon, name }) => (
        <div class='flex flex-col items-center gap-1.5 p-2.5'>
          <Icon
            name={icon}
            class='text-muted hover:text-primary size-7 transition-colors duration-[var(--duration-fast)]'
          />
          <span class='text-muted/70 text-[11px]'>{name}</span>
        </div>
      ))}
    </section>
  )
}

{
  variant === 'mono' && (
    <section class='flex flex-wrap gap-x-1 gap-y-2'>
      {stack.map(({ icon, name }, i) => (
        <div class='group flex items-center'>
          {i > 0 && <span class='text-muted/30'>/</span>}
          <div class='text-muted group-hover:text-primary flex items-center gap-1.5 rounded px-1.5 py-1 font-mono text-xs transition-colors duration-[var(--duration-fast)]'>
            <Icon name={icon} class='size-4' />
            {name}
          </div>
        </div>
      ))}
    </section>
  )
}
