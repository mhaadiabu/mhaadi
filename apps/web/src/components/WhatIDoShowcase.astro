---
// Option 4: Showcase — each activity as a card with a detail line
---

<div class="wido-showcase flex flex-col gap-2">
  {
    [
      {
        text: 'build web & mobile apps',
        detail: 'react, next.js, expo, tailwind',
      },
      {
        text: 'obsess over AI',
        detail: 'llms, embeddings, agents, tooling',
      },
      {
        text: 'read code and docs (a lot)',
        detail: 'github, mdn, spec sheets, blogs',
      },
      {
        text: 'refactor for fun',
        detail: 'clean architecture, patterns, types',
      },
    ].map(({ text, detail }) => (
      <div class="border-border hover:border-secondary bg-bg-secondary/50 group flex flex-col gap-0.5 rounded-lg border p-3 transition-colors duration-200">
        <span class="text-primary text-xs font-medium">{text}</span>
        <span class="text-muted text-xs">{detail}</span>
      </div>
    ))
  }
</div>
