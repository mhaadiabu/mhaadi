---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { ClientRouter } from 'astro:transitions';
import instrumentSansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  date?: string;
  dateTime?: string;
  backTo?: string;
  description?: string | null;
  centered?: boolean;
  time?: number;
  hideDescription?: boolean;
  hideFooter?: boolean;
}

const {
  title = site.name,
  date,
  dateTime,
  backTo = '/',
  description = site.description,
  centered = false,
  time,
  hideDescription = false,
  hideFooter = false,
} = Astro.props;
const isHomepage = Astro.url.pathname === '/';
const showBackButton = !isHomepage && !centered;
---

<!doctype html>
<html lang='en' class='dark overflow-x-clip'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/png' sizes='512x512' href='/favicon.png' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <meta name='generator' content={Astro.generator} />
    {description && <meta name='description' content={description} />}
    <link rel='canonical' href={new URL(Astro.url.pathname, site.url)} />
    <meta name='theme-color' content='#0a0a0a' />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={site.name} />
    <meta property='og:title' content={title} />
    {description && <meta property='og:description' content={description} />}
    <meta property='og:url' content={new URL(Astro.url.pathname, site.url)} />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:title' content={title} />
    {description && <meta name='twitter:description' content={description} />}
    <ClientRouter />
    <link
      rel='preload'
      href={instrumentSansLatin}
      as='font'
      type='font/woff2'
      crossorigin
    />
    <slot name='head' />
    <title>
      {`${title.charAt(0).toUpperCase()}${title.slice(1).toLowerCase()}`}
    </title>

    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline>
      const theme =
        localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body
    class='bg-bg text-secondary typeset typeset-docs container mx-auto w-full max-w-5xl antialiased transition-colors duration-(--duration-fast) max-[39.99rem]:px-2 2xl:max-w-7xl'
  >
    <div class='site-guard flex min-h-screen flex-col'>
      <!-- Theme toggle -->
      <ThemeToggle />
      <main
        class:list={[
          'site-frame mx-auto flex w-full max-w-3xl flex-1 flex-col 2xl:max-w-5xl',
          centered ? 'items-center text-center' : 'items-start text-left',
        ]}
      >
        {
          showBackButton && (
            <header class='page-header relative flex w-full flex-col gap-4 px-4 pt-12 pb-8 sm:px-6'>
              <div class='flex flex-col gap-1.5'>
                <a
                  href={backTo}
                  data-astro-prefetch
                  class='link-underline group text-muted hover:text-primary w-fit self-start'
                >
                  {!isHomepage && (
                    <span class='inline-flex items-center gap-1.5'>
                      <Icon
                        name='arrow-left'
                        class='size-4 shrink-0 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:-translate-x-0.5'
                      />
                      <p class='m-0 text-lg leading-none'>back</p>
                    </span>
                  )}
                </a>
                <h1>{title}</h1>
                {date && (
                  <time
                    class='text-secondary font-mono text-sm'
                    datetime={dateTime}
                  >
                    {date}
                  </time>
                )}
              </div>
              {description && !hideDescription && (
                <p class='text-base leading-loose'>{description}</p>
              )}
              {time && (
                <p class='text-base'>
                  Reading time: <span class='font-semibold'>{time} min</span>
                </p>
              )}
            </header>
          )
        }
        <section
          class:list={[
            'page-content flex w-full flex-1 flex-col',
            isHomepage ? 'p-0' : 'px-4 py-8 sm:px-6',
            centered && 'items-center justify-center',
          ]}
        >
          <slot />
        </section>
      </main>

      {!hideFooter && <Footer />}

      <!-- Scroll to top button -->
      <button
        id='scroll-to-top'
        transition:persist='scroll-to-top'
        class='bg-bg-secondary text-muted hover:text-primary invisible fixed right-6 bottom-6 flex size-11 cursor-pointer items-center justify-center rounded-full p-0 opacity-0 transition-opacity duration-(--duration-fast)'
        aria-label='Scroll to top'
      >
        <Icon name='arrow-top' class='size-4' />
      </button>
    </div>
  </body>
</html>

<script>
  function setupScrollToTop() {
    const btn = document.getElementById('scroll-to-top');
    if (!btn) return;

    const toggleVisibility = () => {
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'invisible');
        btn.classList.add('opacity-100', 'visible');
      } else {
        btn.classList.remove('opacity-100', 'visible');
        btn.classList.add('opacity-0', 'invisible');
      }
    };

    window.addEventListener('scroll', toggleVisibility, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    toggleVisibility();
  }

  setupScrollToTop();
</script>
