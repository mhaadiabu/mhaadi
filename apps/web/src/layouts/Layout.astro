---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  date?: string;
  backTo?: string;
  description?: string;
  centered?: boolean;
  time?: number;
}

const {
  title = 'Haadi',
  date,
  backTo = '/',
  description,
  centered = false,
  time
} = Astro.props;
const isHomepage = Astro.url.pathname === '/';
const showBackButton = !isHomepage && !centered;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {`${title.charAt(0).toUpperCase()}${title.slice(1).toLowerCase()}`}
    </title>

    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline>
      const theme =
        localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-bg text-muted typeset typeset-docs container mx-auto flex min-h-screen w-full max-w-5xl flex-col py-4 antialiased transition-colors duration-200"
  >
    <!-- Theme toggle -->
    <ThemeToggle />
    <main
      class:list={[
        'm-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-4 py-6',
        centered ? 'items-center text-center' : 'items-start text-left',
      ]}
    >
      {
        showBackButton && (
          <>
            <div class="flex flex-col gap-1.5">
              <a
                href={backTo}
                class="group text-muted hover:text-primary transition-colors duration-200"
              >
                {!isHomepage && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon
                      name="arrow-left"
                      class="size-4 shrink-0 transition-transform duration-200 group-hover:-translate-x-0.5"
                    />
                    <p class="m-0 text-base leading-none">back</p>
                  </span>
                )}
              </a>
              <h1>{title}</h1>
              {date && <h5>{date}</h5>}
            </div>
            <p class="leading-loose text-sm">{description}</p>
            {time && (
              <p class="text-sm pb-1.5">
                Reading time: <span class="font-semibold">{time} min</span>
              </p>
            )}
            <hr class="w-full mt-0" />
          </>
        )
      }
      <section
        class:list={[
          'flex flex-1 flex-col py-4 w-full',
          centered && 'items-center justify-center',
        ]}
      >
        <slot />
      </section>
    </main>

    <Footer />

    <!-- Scroll to top button -->
    <button
      id="scroll-to-top"
      class="bg-bg-secondary border-border text-muted hover:text-primary hover:border-secondary invisible fixed right-6 bottom-6 cursor-pointer rounded-full border p-2.5 opacity-0 transition-all duration-200"
      aria-label="Scroll to top"
    >
      <Icon name="arrow-top" class="size-4" />
    </button>
  </body>
</html>

<script>
  function setupScrollToTop() {
    const btn = document.getElementById('scroll-to-top');
    if (!btn) return;

    const toggleVisibility = () => {
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'invisible');
        btn.classList.add('opacity-100', 'visible');
      } else {
        btn.classList.remove('opacity-100', 'visible');
        btn.classList.add('opacity-0', 'invisible');
      }
    };

    if (btn.dataset.bound === 'true') {
      toggleVisibility();
      return;
    }

    window.addEventListener('scroll', toggleVisibility);
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    btn.dataset.bound = 'true';
    toggleVisibility();
  }

  document.addEventListener('astro:page-load', setupScrollToTop);
</script>
