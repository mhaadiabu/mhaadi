---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import { projects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';

type PortfolioItem = Project | Package;

const allItems: PortfolioItem[] = [...projects, ...packages];

const sorted = allItems.sort((a, b) => {
  const aFeatured = a.type === 'project' && a.featured;
  const bFeatured = b.type === 'project' && b.featured;
  if (aFeatured && !bFeatured) return -1;
  if (!aFeatured && bFeatured) return 1;
  if (a.type === 'package' && b.type !== 'package') return -1;
  if (a.type !== 'package' && b.type === 'package') return 1;
  if (a.type === 'project' && b.type === 'project') {
    if (a.disabled && !b.disabled) return 1;
    if (!a.disabled && b.disabled) return -1;
  }
  return 0;
});
const firstProjectIndex = sorted.findIndex((item) => item.type === 'project');
---

<Layout title='projects' description='stuff i built.'>
  <div class='rail-list dim-list flex w-full flex-col divide-y divide-border'>
    <h2 class='sr-only'>project list</h2>
    {
      sorted.map((item, index) => (
        <div class='[contain-intrinsic-size:auto_380px] [content-visibility:auto]'>
          {item.type === 'project' ? (
            <ProjectCard {...item} priority={index === firstProjectIndex} />
          ) : (
            <PackageCard {...item} />
          )}
        </div>
      ))
    }
  </div>
</Layout>
