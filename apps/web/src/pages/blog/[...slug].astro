---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/formatDate';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// auto reading time from body — stops hand-maintaining frontmatter `time`
const time = readingTime(post.body ?? '');
---

<Layout
  title={post.data.title}
  date={formatDate(post.data.date)}
  dateTime={post.data.date.toISOString()}
  time={time}
  description={post.data.description}
  hideDescription
  hideFooter
  backTo='/blog'
  titleTransitionName={`blog-title-${post.id}`}
  dateTransitionName={`blog-date-${post.id}`}
>
  <article class='blog-post flex flex-col gap-4'>
    <Content />
  </article>
</Layout>

<style is:global>
  /* Blog post links stay muted until hover; the underline motion lives globally. */
  .blog-post a {
    color: color-mix(
      in oklab,
      var(--color-primary) 65%,
      var(--color-secondary)
    );
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-smooth-out);
  }
  .blog-post a:hover {
    color: var(--color-primary);
  }
  /* Headings links keep inherited weight */
  .blog-post :is(h1, h2, h3, h4) a {
    font-weight: inherit;
  }
</style>
