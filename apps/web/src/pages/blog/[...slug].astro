---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// auto reading time from body — stops hand-maintaining frontmatter `time`
const time = readingTime(post.body ?? '');
---

<Layout
  title={post.data.title}
  date={post.data.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })}
  dateTime={post.data.date.toISOString()}
  time={time}
  description={post.data.description}
  hideDescription
  backTo='/blog'
>
  <article class='blog-post flex flex-col gap-4'>
    <Content />
  </article>
</Layout>

<style is:global>
  /* Blog post links: underlined, 50% muted then full on hover, brighter/darker per mode */
  .blog-post a {
    color: color-mix(in oklab, var(--color-primary) 65%, var(--color-secondary));
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: color-mix(in oklab, currentColor 50%, transparent);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition:
      color var(--duration-fast) var(--ease-smooth-out),
      text-decoration-color var(--duration-fast) var(--ease-smooth-out);
  }
  .blog-post a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }
  /* Headings links keep inherited weight */
  .blog-post :is(h1, h2, h3, h4) a {
    font-weight: inherit;
  }
</style>
