---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Layout
  title='blog'
  description="i'm not smart. but i think a lot. though my thoughts are almost never complete. i dump them here when they are. enjoy (or don't)."
>
  <div class='blog-list flex w-full flex-col gap-6'>
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            data-astro-prefetch
            class='flex w-full items-baseline justify-between gap-4 transition-opacity duration-[var(--duration-fast)] ease-[var(--ease-in-out)]'
          >
          <div class='flex flex-col gap-0.5'>
            <span class='text-primary text-base font-normal'>
              {post.data.title}
            </span>
            <span class='text-muted line-clamp-3 text-sm'>
              {post.data.description}
            </span>
          </div>
          <time
            datetime={post.data.date.toISOString()}
            class='text-muted whitespace-nowrap tabular-nums'
          >
            {fmt(post.data.date)}
          </time>
        </a>
      ))
    }
  </div>

  <style is:global>
    @media (hover: hover) {
      .blog-list:has(a:hover) a:not(:hover),
      .blog-list:has(a:focus-visible) a:not(:focus-visible) {
        opacity: 0.4;
      }
    }
  </style>
</Layout>
