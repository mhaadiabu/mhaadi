---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title='blog'
  description="i'm not smart. but i think a lot. though my thoughts are almost never complete. i dump them here when they are. enjoy (or don't)."
>
  <div class='blog-list -mx-4 flex w-auto flex-col sm:-mx-6 [&>*]:relative'>
    {
      posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          data-astro-prefetch
          class='flex w-full flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 sm:px-6'
        >
          <div class='flex flex-col gap-0.5'>
            <span class='text-primary text-lg font-normal'>
              {post.data.title}
            </span>
            <span class='text-muted line-clamp-3 text-base'>
              {post.data.description}
            </span>
          </div>
          <time
            datetime={post.data.date.toISOString()}
            class='text-muted pt-1.5 font-mono text-sm whitespace-nowrap tabular-nums sm:pt-0'
          >
            {formatDate(post.data.date)}
          </time>
        </a>
      ))
    }
  </div>
</Layout>
