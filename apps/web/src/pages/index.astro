---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';
import { getCollection } from 'astro:content';

type PortfolioItem = Project | Package;

const projectsSection: PortfolioItem[] = [...featuredProjects, ...packages];
const firstProjectIndex = projectsSection.findIndex((item) => item.type === 'project');

const blogPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
).slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

---

<Layout>
  <header>
    <h1 class="text-primary font-semibold">haadi</h1>
    <p class="text-muted text-sm">frontend engineer</p>
  </header>

  <div
    class="flex flex-col gap-2.5 pt-6 [content-visibility:auto] [contain-intrinsic-size:auto_300px]"
  >
    <SectionHeading text="what i do" variant="edge" />
    <WhatIDo />
  </div>

  <div
    class="flex flex-col gap-2.5 pt-6 [content-visibility:auto] [contain-intrinsic-size:auto_900px]"
  >
    <SectionHeading text="what i work with" variant="edge" />
    <Stack />
  </div>

  <div
    class="flex w-full flex-col gap-4 pt-6 [content-visibility:auto] [contain-intrinsic-size:auto_850px]"
  >
    <SectionHeading text="projects" variant="edge" />
    {
      projectsSection.map((item, index) =>
        item.type === 'project' ? (
          <ProjectCard {...item} priority={index === firstProjectIndex} />
        ) : (
          <PackageCard {...item} />
        ),
      )
    }
    <p>
      interested in other things i&apos;ve worked on? {' '}
      <a
        href="/projects"
        data-astro-prefetch
        class="group text-secondary hover:text-primary inline-flex items-center gap-1 transition-colors"
      >
        check them out <Icon
          name="arrow-right"
          class="size-3.5 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
        />
      </a>
    </p>
  </div>

  <div
    class="flex flex-col gap-2.5 pt-6 [content-visibility:auto] [contain-intrinsic-size:auto_300px]"
  >
    <SectionHeading
      text="blog"
      variant="edge"
      action={
        <a href="/blog" class="group text-sm">
          view all
          <Icon
            name="arrow-right"
            class="size-3.5 -translate-x-1 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
          />
        </a>
      }
    />
    {
      blogPosts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          data-astro-prefetch
          class="group flex w-full items-baseline justify-between gap-4"
        >
          <div class="flex flex-col gap-0.5">
            <span class="text-primary inline-flex items-center gap-1.5 font-normal">
              {post.data.title}
              <Icon
                name="arrow-right"
                class="text-muted size-3 -translate-x-1 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
              />
            </span>
            <span class="text-muted line-clamp-3 text-xs">{post.data.description}</span>
          </div>
          <time
            datetime={post.data.date.toISOString()}
            class="text-muted whitespace-nowrap tabular-nums"
          >
            {fmt(post.data.date)}
          </time>
        </a>
      ))
    }
  </div>
</Layout>
