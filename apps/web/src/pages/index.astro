---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';

type PortfolioItem = Project | Package;

const projectsSection: PortfolioItem[] = [...featuredProjects, ...packages];

const stagger = (index: number) => ({
  style: `animation-delay: ${index * 0.2}s`,
});
---

<Layout>
  <header class="animate-fade-in-up opacity-0" {...stagger(0)}>
    <h1 class="text-primary text-xl font-bold">Haadi</h1>
    <p class="text-muted mb-6 text-sm">frontend guy. unskilled. learning.</p>
    <p>
      hey. i&apos;m haadi. a frontend-forward fullstack developer who enjoys the
      art of software engineering. i&apos;m open to collaborate on any projects
      you might have in mind. feel free to reach out.
    </p>
  </header>

  <div
    class="animate-fade-in-up flex flex-col gap-2.5 pt-6 opacity-0"
    {...stagger(2)}
  >
    <SectionHeading text="what i do" variant="edge" />
    <WhatIDo />
  </div>

  <div
    class="animate-fade-in-up flex flex-col gap-2.5 pt-6 opacity-0"
    {...stagger(3)}
  >
    <SectionHeading text="what i work with" variant="edge" />
    <Stack />
    <!-- <ul class="list-inside list-disc [&>li]:leading-loose">
      <li>react</li>
      <li>nextjs</li>
      <li>tanstack start</li>
      <li>astro</li>
      <li>drizzle + sql</li>
      <li>convex</li>
    </ul> -->
  </div>

  <div
    class="animate-fade-in-up flex w-full flex-col gap-4 pt-6 opacity-0"
    {...stagger(4)}
  >
    <SectionHeading text="projects" variant="edge" />
    {
      projectsSection.map((item) =>
        item.type === 'project' ? (
          <ProjectCard {...item} />
        ) : (
          <PackageCard {...item} />
        ),
      )
    }
    <p class="text-muted pt-2 text-sm">
      interested in other things i&apos;ve worked on?
      <a
        href="/projects"
        class="group text-secondary hover:text-primary inline-flex items-center gap-1 transition-colors"
      >
        check them out <Icon
          name="arrow-right"
          class="size-3.5 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
        />
      </a>
    </p>
  </div>

  <nav class="animate-fade-in-up flex gap-4 pt-6 opacity-0" {...stagger(6)}>
    <a
      href="/blog"
      class="group text-secondary hover:text-primary inline-flex items-center gap-1 transition-colors"
      >blog <Icon
        name="arrow-right"
        class="size-4 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
      /></a
    >
  </nav>
</Layout>
