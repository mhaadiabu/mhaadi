---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Stack from '../components/Stack.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects, type Project } from '../data/projects';
import { packages, type Package } from '../data/packages';
import { getCollection } from 'astro:content';

type PortfolioItem = Project | Package;

const projectsSection: PortfolioItem[] = [...featuredProjects, ...packages];
const firstProjectIndex = projectsSection.findIndex(
  (item) => item.type === 'project',
);

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Layout>
  <header>
    <h1 class='text-primary font-semibold'>haadi</h1>
    <p class='text-muted text-sm'>frontend engineer</p>
  </header>

  <div
    class='flex flex-col gap-2.5 pt-6 [contain-intrinsic-size:auto_300px] [content-visibility:auto]'
  >
    <SectionHeading text='what i like to do' variant='edge' />
    <WhatIDo />
  </div>

  <div
    class='flex w-full flex-col gap-4 pt-6 [contain-intrinsic-size:auto_850px] [content-visibility:auto]'
  >
    <SectionHeading text='my works' variant='edge' />
    {
      projectsSection.map((item, index) =>
        item.type === 'project' ? (
          <ProjectCard {...item} priority={index === firstProjectIndex} />
        ) : (
          <PackageCard {...item} />
        ),
      )
    }
    <p>
      interested in other things i&apos;ve worked on? {' '}
      <a
        href='/projects'
        data-astro-prefetch
        class='group text-secondary hover:text-primary inline-flex items-center gap-1 transition-colors duration-(--duration-fast)'
      >
        check them out <Icon
          name='arrow-right'
          class='size-3.5 -translate-x-1 opacity-0 transition-[opacity,transform] duration-[var(--duration-fast)] ease-[var(--ease-in-out)] group-hover:translate-x-0.5 group-hover:opacity-100'
        />
      </a>
    </p>
  </div>

  <div
    class='flex flex-col gap-2.5 pt-6 [contain-intrinsic-size:auto_300px] [content-visibility:auto]'
  >
    <SectionHeading
      text='recent writes'
      variant='edge'
      action={(
        <a href='/blog' class='group flex items-center gap-1.5 text-sm'>
          view all
          <Icon
            name='arrow-right'
            class='size-3 transition-transform duration-[var(--duration-fast)] ease-[var(--ease-in-out)] group-hover:translate-x-0.5'
          />
        </a>
      )}
    />
    <div class='blog-list flex flex-col gap-4'>
      {
        blogPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            data-astro-prefetch
            class='flex w-full items-baseline justify-between gap-4 transition-opacity duration-[var(--duration-fast)] ease-[var(--ease-in-out)]'
          >
            <div class='flex flex-col gap-0.5'>
              <span class='text-primary text-base font-normal'>
                {post.data.title}
              </span>
              <span class='text-muted line-clamp-3 text-sm'>
                {post.data.description}
              </span>
            </div>
            <time
              datetime={post.data.date.toISOString()}
              class='text-muted whitespace-nowrap tabular-nums'
            >
              {fmt(post.data.date)}
            </time>
          </a>
        ))
      }
    </div>
  </div>

  <div
    class='flex flex-col gap-2.5 pt-6 [contain-intrinsic-size:auto_900px] [content-visibility:auto]'
  >
    <SectionHeading text='what i work with' variant='edge' />
    <Stack />
  </div>
</Layout>
