---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title='404' centered>
  <Fragment slot='head'><meta name='robots' content='noindex' /></Fragment>
  <h1
    class='text-primary m-0 mb-4 text-8xl font-semibold'
    data-page-reveal
    style='--page-reveal-index: 0'
  >
    404
  </h1>
  <p class='mb-4' data-page-reveal style='--page-reveal-index: 1'>
    nothing to see here.
  </p>
  <a
    href='/'
    data-astro-prefetch
    data-page-reveal
    style='--page-reveal-index: 2'
    class='link-underline group text-secondary hover:text-primary inline-flex items-center gap-1'
  >
    <Icon
      name='arrow-left'
      class='size-4 transition-transform duration-[var(--duration-quick)] ease-[var(--ease-smooth-out)] group-hover:-translate-x-0.5'
    />
    go back home
  </a>
</Layout>
