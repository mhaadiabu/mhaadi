{
  "name": "portfolio",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.10",
      "zod": "^4.6.7",
      "tsrs": "7.1.0-beta.tsrs5",
      "@cloudflare/workers-types": "^5.20261125.1",
      "alchemy": "^0.91.2"
    }
  },
  "type": "module",
  "scripts": {
    "lint:typecheck": "TSRS_FAST=1 oxlint --type-aware --type-check",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "deploy": "turbo -F @portfolio/infra deploy",
    "destroy": "turbo -F @portfolio/infra destroy",
    "update:contributions": "bun scripts/update-contributions.ts",
    "check": "oxlint && bun run format",
    "format": "bun run --cwd apps/web format",
    "lint": "turbo lint",
    "fmt": "turbo format"
  },
  "dependencies": {
    "@portfolio/env": "workspace:*",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@portfolio/config": "workspace:*",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.13",
    "tsrs": "7.1.0-beta.tsrs5"
  },
  "packageManager": "bun@1.3.10"
}
